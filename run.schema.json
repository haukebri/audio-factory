{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "signature",
    "status",
    "request",
    "started_at",
    "audio_path",
    "models",
    "runtime",
    "settings",
    "licenses",
    "review"
  ],
  "properties": {
    "generation_prompt": { "type": "string", "minLength": 1 },
    "prompt_plan": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "status",
            "intent",
            "generation_prompts",
            "qa_target",
            "model",
            "instructions_sha256",
            "error"
          ],
          "properties": {
            "version": {
              "const": "prompt-plan-v1"
            },
            "status": {
              "enum": [
                "completed",
                "fallback"
              ]
            },
            "intent": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "\\S"
            },
            "generation_prompts": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "\\S"
              }
            },
            "qa_target": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "\\S"
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "instructions_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "error": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "status",
            "intent",
            "generation_prompts",
            "model",
            "instructions_sha256",
            "error"
          ],
          "properties": {
            "version": {
              "const": "prompt-plan-v2"
            },
            "status": {
              "const": "completed"
            },
            "intent": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "pattern": "\\S"
            },
            "generation_prompts": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000,
                "pattern": "\\S"
              }
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "instructions_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "error": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 2000
            }
          }
        }
      ]
    },
    "schema": {
      "const": "urban:audio-factory-run@1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "generating",
        "completed",
        "failed",
        "interrupted"
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt",
        "duration_seconds",
        "seed"
      ],
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 60
        },
        "loop": { "type": "boolean" },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    },
    "elapsed_ms": {
      "type": "number",
      "minimum": 0
    },
    "progress": {},
    "error": {
      "type": "string"
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_rate",
        "channels",
        "seconds",
        "peak",
        "rms",
        "bytes"
      ],
      "properties": {
        "sample_rate": {
          "const": 44100
        },
        "channels": {
          "const": 2
        },
        "seconds": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 60
        },
        "peak": {
          "type": "number",
          "maximum": 0.708,
          "minimum": 0
        },
        "rms": {
          "type": "number",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 44
        }
      }
    },
    "audio_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "audio_path": {
      "type": "string",
      "pattern": "^(out/)?runs/[a-f0-9]{32}/audio\\.wav$"
    },
    "models": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "url",
          "sha256",
          "bytes"
        ],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_.-]+\\.(gguf|npz)$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://huggingface.co/"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "licenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "url"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "runtime": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "revision",
            "backend"
          ],
          "properties": {
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "backend": {
              "enum": [
                "metal",
                "mlx"
              ]
            },
            "name": {
              "const": "sa3.cpp"
            },
            "ggml_revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "encoding": {
              "const": "F16"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backend",
            "model"
          ],
          "properties": {
            "backend": {
              "const": "elevenlabs"
            },
            "model": {
              "const": "eleven_text_to_sound_v2"
            }
          }
        }
      ]
    },
    "settings": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "steps",
            "cfg_scale",
            "duration_padding_sec",
            "peak_db"
          ],
          "properties": {
            "steps": {
              "type": "integer",
              "minimum": 1
            },
            "cfg_scale": {
              "const": 1
            },
            "duration_padding_sec": {
              "enum": [
                0,
                6
              ]
            },
            "peak_db": {
              "type": "number",
              "minimum": -20,
              "maximum": -3
            },
            "sampler": {
              "type": "string",
              "minLength": 1
            },
            "decoder": {
              "type": "string",
              "minLength": 1
            },
            "text_encoder": {
              "type": "string",
              "minLength": 1
            },
            "postprocess": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "peak_db",
            "prompt_influence",
            "loop",
            "postprocess"
          ],
          "properties": {
            "peak_db": {
              "type": "number",
              "minimum": -20,
              "maximum": -3
            },
            "prompt_influence": {
              "const": 0.3
            },
            "loop": {
              "type": "boolean"
            },
            "postprocess": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "review": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "required": [
          "audio",
          "audio_sha256",
          "finished_at",
          "elapsed_ms"
        ],
        "properties": {
          "audio": true,
          "audio_sha256": true,
          "finished_at": true,
          "elapsed_ms": true
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime": {
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "const": "sa3.cpp"
              }
            },
            "type": "object"
          }
        }
      },
      "then": {
        "properties": {
          "runtime": {
            "required": [
              "ggml_revision",
              "encoding"
            ],
            "type": "object",
            "properties": {
              "ggml_revision": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "encoding": {
                "const": "F16"
              }
            }
          },
          "models": {
            "minItems": 5,
            "maxItems": 5,
            "type": "array"
          },
          "settings": {
            "required": [
              "sampler",
              "decoder",
              "text_encoder",
              "postprocess"
            ],
            "type": "object",
            "properties": {
              "sampler": {
                "type": "string",
                "minLength": 1
              },
              "decoder": {
                "type": "string",
                "minLength": 1
              },
              "text_encoder": {
                "type": "string",
                "minLength": 1
              },
              "postprocess": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime": {
            "type": "object",
            "required": [
              "backend"
            ],
            "properties": {
              "backend": {
                "const": "elevenlabs"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "models": {
            "type": "array",
            "maxItems": 0
          },
          "settings": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "peak_db",
              "prompt_influence",
              "loop",
              "postprocess"
            ],
            "properties": {
              "peak_db": {
                "type": "number",
                "minimum": -20,
                "maximum": -3
              },
              "prompt_influence": {
                "const": 0.3
              },
              "loop": {
                "type": "boolean"
              },
              "postprocess": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "models": {
            "type": "array",
            "minItems": 3
          },
          "licenses": {
            "type": "array",
            "minItems": 2
          },
          "settings": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "steps",
              "cfg_scale",
              "duration_padding_sec",
              "peak_db"
            ],
            "properties": {
              "steps": {
                "type": "integer",
                "minimum": 1
              },
              "cfg_scale": {
                "const": 1
              },
              "duration_padding_sec": {
                "enum": [
                  0,
                  6
                ]
              },
              "peak_db": {
                "type": "number",
                "minimum": -20,
                "maximum": -3
              },
              "sampler": {
                "type": "string",
                "minLength": 1
              },
              "decoder": {
                "type": "string",
                "minLength": 1
              },
              "text_encoder": {
                "type": "string",
                "minLength": 1
              },
              "postprocess": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
