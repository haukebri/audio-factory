{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["prompt"],
  "properties": {
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 60
    },
    "loop": { "type": "boolean" },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    }
  }
}
