{
  "name": "audio-factory",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:audio-factory": "node --test service.test.mjs standalone-core.test.mjs qa.test.mjs review-store.test.mjs studio.test.mjs && .runtime/mlx-venv/bin/python qa_test.py",
    "audio:factory": "pnpm build && node dist/cli.js",
    "audio:smoke": "pnpm build && node smoke.mjs"
  },
  "dependencies": {
    "ajv": "8.18.0"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.5"
    }
  }
}
