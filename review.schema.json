{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "rationale", "analysis_ids"],
  "properties": {
    "status": {
      "enum": ["provisional", "accepted", "rejected", "auto_accepted", "needs_review"]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "analysis_ids": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{32}$"
      }
    }
  }
}
